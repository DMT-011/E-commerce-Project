@using E_commerce_Project.Helpers
@model E_commerce_Project.Models.ViewModels.ProductViewModel.ProductDetailViewModel;
@{
  // Breadcrumb place
  ViewBag.currentPlace = @Model.Name;
}

@section Styles {
  <link rel="stylesheet" href="~/css/product/detailProduct.css">
}

<div class="main-content" style="margin: 0;">
  <div class="container">
    <!-- Breadcrumb area -->
    <div class="row">
      <div class="col-12">
        @await Html.PartialAsync("PartialViews/Customer/_BreadCrumbSection")
      </div>
    </div>

    <!-- Detail product area -->
    <div class="row">
      <!-- Detail product-->
      <div class="col-9">
        <!-- Product view area -->
        <div class="row">
          <!-- Product view img -->
          <div class="col-5">
            <div class="product-view-area">
              <div class="product-view-slide nivoSlider">
                <img src="/@Model.ImageMainPath" data-thumb="/@Model.ImageMainPath" alt="">
                <img src="/@Model.ImageSub1Path" data-thumb="/@Model.ImageSub1Path" alt="">
                <img src="/@Model.ImageSub2Path" data-thumb="/@Model.ImageSub2Path" alt="">
                <img src="/@Model.ImageSub3Path" data-thumb="/@Model.ImageSub3Path" alt="">
              </div>

              <div class="view-large-btn">
                View large
                <i class="bi view-large-icon bi-zoom-in"></i>
              </div>
            </div>
          </div>

          <!-- Product desc area -->
          <div class="col-7">
            <div class="product-wrapper">
              <div class="product-description">
                <h3 class="product-title-name">@Model.Name</h3>
              </div>
              <div class="review-box">
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
              </div>
              <div class="product-condition">
                <p>
                  Sản phẩm có sẵn:
                  <span class="product-condition-quantity">@Model.Quantity</span>
                </p>
                <p>
                  Tình trạng:
                  <span class="product-condition-text">New</span>
                </p>
              </div>
              <div class="product-price-area">
                <p class="product-price-new">
                  @CurrencyFormatterHelper.Format(@Model.HasDiscount ? @Model.PromotionPrice ?? 0 : @Model.Price)<sup>đ</sup>
                </p>
                @if (@Model.HasDiscount)
                {
                  <p class="product-price-old">
                    @CurrencyFormatterHelper.Format(@Model.Price)<sup>đ</sup>
                  </p>
                }
              </div>
              <div class="product-desc-text">
                @Html.Raw(@Model.Description)
              </div>
              <div class="product-select-quantity">
                <span>Số lượng</span>
                <input type="number" value="1" min="1" name="productQuantity" id="numberProduct">
              </div>
              <div class="product-controls">
                <button class="buy-product-btn btn btn-dark">Mua ngay</button>
                <button class="add-product-cart-btn btn btn-outline-dark">Thêm vào giỏ hàng</button>
              </div>
            </div>
          </div>

        </div>

        <!-- Detail info product area -->
