@model IEnumerable<E_commerce_Project.Models.ViewModels.ProductViewModel.ProductSalesViewModel>;
<!-- Sidebar title -->
<div class="single-left-sidebar">
    <div class="left-title-area">
        <h3 class="left-title">Sản phẩm khuyến mãi</h3>
    </div>
</div>

<!-- List promotional products  -->
<div class="list-product-sales">
    @foreach (var item in Model)
    {
        <div class="single-product-item">
            <div class="sidebar-product-img">
                <a href="@item.Slug" class="sidebar-product-link">
                    <img src="~/@item.ImagePath" alt="">
                </a>
            </div>

            <div class="sidebar-product-desc">
                <a href="" class="sidebar-product-name">@item.Name</a>
                <div class="customer-comment-box">
                    <div class="rating-box">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                </div>

                <div class="price-box">
                    <span class="old-price">@item.Price<sup>đ</sup> </span>
                    <span class="new-price">@item.PromotionPrice<sup>đ</sup> </span>
                </div>
            </div>
        </div>
    }
</div>

