@model E_commerce_Project.Models.ViewModels.ProductViewModel.ProductCreateViewModel;
@{
    ViewBag.Title = "title";
    Layout = "_LayoutAdminForm";
    ViewBag.titleView = "Sản phẩm";
    ViewBag.featureCurrent = "Thêm sản phẩm";
}

@section StylesViewChild
{
	<link rel="stylesheet" href="~/css/admin/addProductForm.css">
	<script src="https://cdn.tiny.cloud/1/kni28pimx3vbme8ar0q8guu556w4ig99fxodlsqrr7ettxqb/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@tinymce/tinymce-jquery@2/dist/tinymce-jquery.min.js"></script>
}

@section ControlsAdmin
{
	<button class="btn btn-primary btn-create-product">
		<i class="icon-control fas fa-calendar-check"></i>
		Xác nhận
	</button>
	<a href="/Admin/Product" class="btn btn-black">
		<i class="icon-control fas fa-reply"></i>
		Quay lại
	</a>
}
	
<!-- Add product form admin-->
<form action="/Product/Create" method="POST" enctype="multipart/form-data" id="form-create-product" class="add-product-form-area">
	<div class="row">
		<div class="col-12">
			<div class="label-notice">* Các mục đánh dấu (*) là bắt buộc</div>
		</div>
		<!-- Form side left -->
		<div class="col-9">
			<div class="form-left">
				<div class="form-group">
					<label for="name-product" class="form-label">Tên sản phẩm</label>
					<input asp-for="Name" type="text" class="form-input" id="name-product">
				</div>

				<div class="form-group">
					<label for="product-desc-content" class="form-label">Mô tả sản phẩm</label>
					<textarea asp-for="Description" id="product-desc-content"></textarea>
				</div>

				<div class="form-group">
					<label for="product-detail-content" class="form-label">Chi tiết sản phẩm</label>
					<textarea asp-for="Detail" id="product-detail-content"></textarea>
				</div>
			</div>
		</div>

		<!-- Form side right -->
		<div class="col-3">
			<div class="form-right">
				<div class="form-group">
					<label class="form-label">Hình ảnh</label>
					<div class="upload-img-item">
						<span class="upload-img-title">Ảnh chính</span>
						<input asp-for="ImageMain" type="file" class="img-product-main">

						<div class="img-product-wrapper">
							<img accept="image/*" src="" class="product-img-view" alt="">
						</div>
					</div>

					<div class="upload-img-item">
						<span class="upload-img-title">Ảnh phụ 1</span>
						<input asp-for="ImageSub1" type="file" class="img-product-sub-1">

						<div class="img-product-wrapper">
							<img accept="image/*" src="" class="product-img-view" alt="">
						</div>
					</div>

					<div class="upload-img-item">
						<span class="upload-img-title">Ảnh phụ 2</span>
						<input asp-for="ImageSub2" type="file" class="img-product-sub-2">
						
						<div class="img-product-wrapper">
							<img accept="image/*" src="" class="product-img-view" alt="">
						</div>
					</div>

					<div class="upload-img-item">
						<span class="upload-img-title">Ảnh phụ 3</span>
						<input asp-for="ImageSub3" type="file" class="img-product-sub-3">
						
						<div class="img-product-wrapper">
							<img accept="image/*" src="" class="product-img-view" alt="">
						</div>
					</div>
				</div>

				<div class="form-group">
					<label for="category-product" class="form-label">Loại sản phẩm</label>

					<select asp-for="CategoryId" asp-items="Model.Categories" id="category-product" class="select-input">
						<option value="">[ Chọn loại sản phẩm ]</option>
					</select>
				</div>
				
				<div class="form-group">
					<label for="product-quantity" class="form-label">Số lượng</label>
					<input asp-for="Quantity" type="number" min="1" value="1" class="form-input" id="product-quantity">
				</div>

				<div class="form-group">
					<label for="product-price" class="form-label">Giá gốc</label>
					<input asp-for="Price" type="text"  class="form-input price-format" id="product-price">
				</div>

				<div class="form-group">
					<label for="product-price-promotion" class="form-label">Giá khuyến mãi</label>
					<input asp-for="PromotionPrice" type="text" class="form-input price-format" id="product-price-promotion">
				</div>

				<div class="form-group">
					<label for="product-has-promotion" class="form-label">Chương trình giảm giá</label>

					<select asp-for="HasDiscount" id="product-has-promotion" class="select-input">
						<option value="true">Có</option>
						<option value="false">Không</option>
					</select>
				</div>

				<div class="form-group">
					<label for="product-status" class="form-label">Trạng thái</label>

					<select asp-for="IsDisplayed" id="product-status" class="select-input">
						<option value="true">Hiển thị</option>
						<option value="false">Không hiện thị</option>
					</select>
				</div>
				

			</div>
		</div>
	</div>
</form>


@section ScriptsViewChild
{
	<script>
		const inputPrice = document.querySelectorAll(".price-format")
		// Format value price when onchange
		inputPrice.forEach(function (input) {
			input.addEventListener('input', function (e) {
				let value = this.value;
				value = value.replace(/\D/g, '');
				value = new Intl.NumberFormat('vi-VN').format(value);
				this.value = value;
			});
		})
	
	</script>
	
	<!-- Tiny editor -->
	<script>
		document.addEventListener("DOMContentLoaded", () => {
			// Text editor product desc content
			tinymce.init({
				selector: "#product-desc-content",
				height: 400,
				menubar: true,
				plugins: [
					'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
					'anchor', 'searchreplace', 'visualblocks', 'fullscreen',
					'insertdatetime', 'media', 'table', 'code', 'help', 'wordcount'
				],
				toolbar: 'undo redo | blocks | bold italic backcolor | ' +
					'alignleft aligncenter alignright alignjustify | ' +
					'bullist numlist outdent indent | removeformat | fullscreen | preview | help',
			});

			// Text editor product detail content
			tinymce.init({
				selector: "#product-detail-content",
				height: 400,
				menubar: true,
				plugins: [
					'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
					'anchor', 'searchreplace', 'visualblocks', 'fullscreen',
					'insertdatetime', 'media', 'table', 'code', 'help', 'wordcount'
				],
				toolbar: 'undo redo | blocks | bold italic backcolor | ' +
					'alignleft aligncenter alignright alignjustify | ' +
					'bullist numlist outdent indent | removeformat | fullscreen | preview | help',
			});
		});
	</script>

	<script>
		const btnToggleNavBars = document.querySelectorAll(".btn-toggle");

		btnToggleNavBars.forEach(function(btnItem) {

			btnItem.addEventListener("click", function(e) {
				e.preventDefault();
			});
		});
		
		const btnCreateProduct = document.querySelector(".btn-create-product");

		btnCreateProduct.onclick = function () {
			document.querySelector("#form-create-product").submit();
		}
	</script>
	
	<!-- Auto render img when upload other file img -->
	<script>
		function handleRenderImageOnchange(inputElement, imgElement) {
			inputElement.addEventListener("input", function(e) {
				const fileImg = e.target.files[0];
				const imgWrapper = imgElement.parentElement;

				if (fileImg) {
					const reader = new FileReader();

					reader.onload = function(e) {
						// assign url img to img element
						imgElement.src = e.target.result;
						imgElement.style.display = "inline-block";
						imgWrapper.style.borderBottom = "1px dashed #ededed";
						imgWrapper.style.display = "block";
					}

					// Read file as a URL
					reader.readAsDataURL(fileImg);


				} else {
					imgElement.src = "";
					imgElement.style.display = "none";
					imgWrapper.style.display = "none";
					imgWrapper.style.borderBottom = "";
				}

			});
		}


		const inputImageMain = document.querySelector(".img-product-main");
		const imageMain = inputImageMain.parentElement.querySelector(".product-img-view");

		const inputImageSub1 = document.querySelector(".img-product-sub-1");
		const imageSub1 = inputImageSub1.parentElement.querySelector(".product-img-view");

		const inputImageSub2 = document.querySelector(".img-product-sub-2");
		const imageSub2 = inputImageSub2.parentElement.querySelector(".product-img-view");

		const inputImageSub3 = document.querySelector(".img-product-sub-3");
		const imageSub3 = inputImageSub3.parentElement.querySelector(".product-img-view");

		const imgWrappers = document.querySelectorAll(".upload-img-item .img-product-wrapper");

		imgWrappers.forEach(function(imgWrapperItem) {
			imgWrapperItem.style.display = "none";
		})

		handleRenderImageOnchange(inputImageMain, imageMain);
		handleRenderImageOnchange(inputImageSub1, imageSub1);
		handleRenderImageOnchange(inputImageSub2, imageSub2);
		handleRenderImageOnchange(inputImageSub3, imageSub3);
	</script>
}
