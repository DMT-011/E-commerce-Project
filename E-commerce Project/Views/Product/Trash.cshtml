@using E_commerce_Project.Helpers
@model X.PagedList.IPagedList<E_commerce_Project.Models.ViewModels.AdminViewModel.AdminProductTrashViewModel>;

@{
  Layout = "_LayoutAdminTable";
  ViewBag.titleView = "Sản phẩm";
  ViewBag.featureCurrent = "Thùng rác";
  // Action for pagination section
  ViewBag.action = "Trash";
}

@section StylesViewChild
{
  <link rel="stylesheet" href="~/css/admin/adminDelete.css" asp-append-version="true">
}

@section ControlsAdmin
{
  <a href="/Admin/Product" class="btn btn-black">
    <i class="icon-control fas fa-reply"></i>
    Quay lại
  </a>
}


@if (Model.Count > 0)
{
  <table class="table align-middle table-product-list">
    <thead>
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Hình ảnh</th>
      <th scope="col">Tên sản phẩm</th>
      <th scope="col">Giá</th>
      <th scope="col">Thao tác</th>
    </tr>
    </thead>

    <tbody class="table-group-divider">
    @foreach (var item in Model)
    {
      <tr class="product-item">
        <th scope="row">
          <i
            class="fas fa-angle-right icon-product-right"
            style="opacity: 0.9"
          ></i>
          <i
            class="fas fa-angle-down icon-product-down hidden-icon-product"
            style="opacity: 0.9"
          ></i>
          <span class="id-product" style="margin-left: 2px"
          >@item.Id</span
          >
        </th>
        <td>
          <img
            src="~/@item.ImagePath"
            class="product-img"
            alt=""
          />
        </td>
        <td>
          <a href="#" class="product-detail-link"
          >@item.Name</a
          >
        </td>
        <td>@CurrencyFormatterHelper.Format(@item.Price)<sup>đ</sup></td>
        <td class="product-controls">
          <button
            class="btn btn-black btn-restore-product"
            data-bs-toggle="tooltip"
            data-bs-placement="top"
            data-bs-title="Khôi phục"
            data-product-id="@item.Id"
          >
            <i class="fas fa-sync-alt"></i>
          </button>

          <button
            class="btn btn-danger"
            data-bs-toggle="modal"
            data-bs-target="#modal-confirm-forceDelete"
            data-product-id="@item.Id"
            data-product-name="@item.Name"
          >
            <i class="fas fa-trash-alt"></i>
          </button>
        </td>

        <td class="content-hidden" style="display: none">
          @item.CategoryName
        </td>
        <td class="content-hidden" style="display: none">
          @item.CreatedDate
        </td>
        <td class="content-hidden" style="display: none">
          @CurrencyFormatterHelper.Format(@item.PromotionPrice ?? 0)
        </td>
      </tr>
      <tr style="display: none"></tr>
    }
    </tbody>
  </table>

  @section Pagination
  {
    @await Html.PartialAsync("PartialViews/Admin/_PaginationSection", Model)
  }
}

@if (Model.Count == 0)
{
ViewBag.contentEmpty = "Thùng rác rỗng, quay lại danh sách ";
ViewBag.contentLink = "sản phẩm";
ViewBag.actionEmpty = "/Admin/Product";
ViewBag.imgEmpty = "trash-empty-color.jpg";
  @await Html.PartialAsync("PartialViews/Admin/_EmptySection")
}



<!-- Form restore and force delete product -->
<form action="" method="POST" id="form-restore-product"></form>
<form action="" method="POST" id="form-force-delete-product"></form>

@section ModalConfirm
{
  <!-- Modal -->
  <div class="modal fade" id="modal-confirm-forceDelete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="exampleModalLabel">Xóa vĩnh viễn sản phẩm này ?</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          Hãy chắc chắn rằng bạn muốn xóa nó.
          Hành động này sẽ xóa vĩnh viễn sản phẩm
          <span style="font-weight: bold" class="product-name"></span>
          , không thể khôi phục lại !
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
          <button type="button" class="btn btn-danger btn-confirm-forceDel">Xóa vĩnh viễn</button>
        </div>
      </div>
    </div>
  </div>
}

@section ScriptsViewChild
{
  @await Html.PartialAsync("PartialViews/Admin/_NoticeSection");

  <script>
    const formRestore = document.querySelector("#form-restore-product");
    const btnRestore = document.querySelectorAll(".btn-restore-product");

    btnRestore.forEach(item => {
      item.addEventListener("click", function () {
        const id = this.dataset.productId;
        formRestore.action = `/Product/Restore/${id}`;
        formRestore.submit();
      })
    });

    const formForceDelete = document.querySelector("#form-force-delete-product");
    const btnConfirmForceDel = document.querySelector(".btn-confirm-forceDel");
    const modalConfirmForceDel = document.querySelector("#modal-confirm-forceDelete");

    if (modalConfirmForceDel) {
      modalConfirmForceDel.addEventListener('show.bs.modal', event => {
        const contentBody = document.querySelector(".product-name");
        const productId = event.relatedTarget.dataset.productId;
        const productName = event.relatedTarget.dataset.productName;

        formForceDelete.action = `/Product/ForceDelete/${productId}`;
        contentBody.textContent = productName;
      });
    }
    btnConfirmForceDel.onclick = function () {
      formForceDelete.submit();
    }
  </script>

  <!-- Script droplist table -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const productItems = document.querySelectorAll(
        ".table-product-list .product-item"
      );

      // Show detail product when click on productItem 
      productItems.forEach(function (productItem) {
        productItem.addEventListener("click", function () {
          const productItemClick = this;
          const productIconRight = productItemClick.querySelector(
            ".icon-product-right"
          );
          const productIconDown =
            productItemClick.querySelector(".icon-product-down");
          const hasNextElement = productItemClick.nextElementSibling;

          if (hasNextElement.classList.contains("detail-product")) {
            hasNextElement.classList.toggle("hidden-detail-product");

            productIconDown.classList.toggle("hidden-icon-product");
            productIconRight.classList.toggle("hidden-icon-product");
          } else {
            const productContent =
              productItemClick.querySelectorAll(".content-hidden");
            const detailProductElement = `
                <tr class="detail-product">
                    <td colspan="5">
                      <div class="detail-product-inner">
                         <div class="detail-product-row">
                            <div class="detail-product-name">Loại sản phẩm:</div>
                            <div class="detail-product-value">${productContent[0].textContent}</div>
                          </div>
                          <div class="detail-product-row">
                            <div class="detail-product-name">Giá khuyển mãi:</div>
                            <div class="detail-product-value" style="font-weight: 600">${productContent[2].textContent.trim()}<sup>đ</sup></div>
                          </div>

                          <div class="detail-product-row">
                                <div class="detail-product-name">Ngày tạo:</div>
                                <div class="detail-product-value">${productContent[1].textContent}</div>
                          </div>
                         
                      </div>
                    </td>
                  </tr>
        
        `;

            productItemClick.insertAdjacentHTML(
              "afterend",
              detailProductElement
            );
            productIconRight.classList.add("hidden-icon-product");
            productIconDown.classList.remove("hidden-icon-product");
          }
        });
      });

      //Remove event when click controls
      const productControls = document.querySelectorAll(".table-product-list .product-controls");

      productControls.forEach(productControl => {
        const btnControls = productControl.querySelectorAll(".btn");

        btnControls.forEach(btnItems => {
          btnItems.addEventListener("click", function (e) {
            e.stopPropagation();
          });

        });

      });
    });
  </script>

}
