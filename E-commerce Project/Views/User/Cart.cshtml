@using E_commerce_Project.Helpers
@model IEnumerable<E_commerce_Project.Models.ViewModels.CartViewModel.CartItemTableViewModel>;

@{
  // Breadcrumb place
  ViewBag.currentPlace = "Giỏ hàng";
}

@section Styles
{
  <link rel="stylesheet" href="~/css/product/cartProduct.css" asp-append-version="true">
}

<!-- Main content -->
<div class="main-content" style="margin: 0;">
  <div class="container">
    <!-- Breadcrumb area -->
    <div class="row">
      <div class="col-12">
        @await Html.PartialAsync("PartialViews/Customer/_BreadCrumbSection")
      </div>
    </div>



    @if (Model.Count() > 0)
    {
      <!-- Product list in cart  -->
      <div class="row">
        <div class="col-12">
          <!-- Product list area -->
          <div class="table-responsive">
            <table class="table list-product-cart-area align-middle">
              <thead class="table-dark">
              <tr>
                <th scope="col">Hình ảnh</th>
                <th scope="col">Tên sản phẩm</th>
                <th scope="col">Đơn giá</th>
                <th scope="col">Số lượng</th>
                <th scope="col">Thành tiền</th>
                <th scope="col">Xóa</th>
              </tr>
              </thead>

              <tbody class="table-group-divider">
              @foreach (var item in Model)
              {
                <!-- Item Product -->
                <tr class="table-cart-item">
                  <td>
                    <a href="/Product?slug=@item.Slug" class="product-link-img-cart">
                      <img src="/@item.ImagePath" alt="">
                    </a>
                  </td>

                  <td>
                    <p class="product-name-cart">
                      <a href="/Product?slug=@item.Slug">
                        @item.Name
                      </a>
                    </p>
                  </td>

                  <td>
                    <p class="product-price-cart">
                      @CurrencyFormatterHelper.Format(@item.Price)<sup>đ</sup>
                    </p>
                  </td>
                  <td>
                    <div class="product-quantity-cart">
                      <input type="number" name="quantity-product-select" value="@item.QuantityOrder" min="1" id="">
                    </div>
                  </td>
                  <td>
                    <div class="total-price-cart">
                    <span class="price">
                      @CurrencyFormatterHelper.Format(@item.TotalPrice)<sup>đ</sup>
                    </span>
                    </div>
                  </td>

                  <td>
                  <span class="cart-delete-product">
                    <a href="">
                      <i class="bi bi-trash3-fill"></i>
                    </a>
                  </span>
                  </td>
                </tr>
              }
              </tbody>

            </table>

          </div>

        </div>

        <!-- Return shop area -->
        <div class="col-12" style="display: block;">
          <div class="return-continute-shop">
            <div class="return-home-btn">
              <a href="/">
                <i class="bi bi-arrow-left-circle-fill"></i>
                Tiếp tục mua hàng
              </a>
            </div>

            <div class="order-controls">
              <button class="remove-all-product-btn btn btn-danger">Xóa tất cả</button>
              <button class="order-product-btn btn btn-dark">Đặt hàng</button>
            </div>
          </div>

        </div>

      </div>
    }
    else
    {
      <!-- Cart empty  -->
      <div class="empty-cart-wrapper">
        <img src="/images/empty/empty-cart.jpg" alt="">
        <div class="empty-desc">
          <p>Giỏ hàng hiện tại rỗng</p>
        </div>
      </div>
      
      <!-- Return shop area -->
      <div class="col-12" style="display: block;">
        <div class="return-continute-shop">
          <div class="return-home-btn">
            <a href="/">
              <i class="bi bi-arrow-left-circle-fill"></i>
              Quay lại trang chủ
            </a>
          </div>
        </div>

      </div>

    }

  </div>
</div>

<form action="/Cart/Payment?userId=@User.FindFirst("userId")?.Value" method="POST" id="form-payment-product"></form>

<!-- Infomation order && methods payment area -->
@await Component.InvokeAsync("PaymentOrder", int.Parse(@User.FindFirst("userId")?.Value))

@section Scripts
{
  <script>
    const btnOrderProduct = document.querySelector(".order-product-btn");
    const paymentBlock = document.querySelector(".payment-block");
    const orderControlBlock = document.querySelector(".return-continute-shop");

    btnOrderProduct.addEventListener("click", (e) => {
      paymentBlock.style.display = "block";
      orderControlBlock.style.display = "none";
    });

    const formPayment = document.querySelector("#form-payment-product");
    const btnConfirmPayment = document.querySelector(".payment-confirm-btn")

    btnConfirmPayment.addEventListener("click", (e) => {
      formPayment.submit();
    })
  </script>
}
