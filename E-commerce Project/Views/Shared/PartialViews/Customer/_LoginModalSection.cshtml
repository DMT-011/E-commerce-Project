
<div class="modal fade" id="modal-login" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content"> 
            <div class="modal-body">
                <div class="container-content">
                    <div class="login-box">
                        <div class="modal-close">
                            <i class="bi bi-x-circle-fill" data-bs-dismiss="modal"></i>
                        </div>
                        <div class="logo">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/f/fa/Apple_logo_black.svg" alt="Apple Logo">
                        </div>
                        <h1>Chào mừng đến với Apple Store</h1>
                        <p>Đăng nhập để khám phá những sản phẩm tuyệt vời</p>
                        <form id="loginForm">
                            <div class="form-group">
                                <input id="username" type="text" id="username" placeholder="Tên đăng nhập" required>
                            </div>
                            <div class="form-group">
                                <input type="password" id="password" placeholder="Mật khẩu" required>
                            </div>
                            <button type="submit">Đăng Nhập</button>
                        </form>
                        <p class="signup-link">Chưa có tài khoản? <a data-bs-dismiss="modal" class="btn-move-register" href="">Đăng ký ngay</a></p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

