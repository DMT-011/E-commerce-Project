<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    
    <!-- Fonts and icons -->
    <script src="~/js/admin/plugin/webfont/webfont.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
   
    <script>
        WebFont.load({
            google: { families: ["Public Sans:300,400,500,600,700"] },
            custom: {
                families: [
                    "Font Awesome 5 Solid",
                    "Font Awesome 5 Regular",
                    "Font Awesome 5 Brands",
                    "simple-line-icons",
                ],
                urls: ["/css/admin/fonts.min.css"],
            },
            active: function () {
                sessionStorage.fonts = true;
            },
        });
    </script>
    <!-- CSS Files -->
    <link rel="stylesheet" href="~/css/admin/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin/plugins.min.css" />
    <link rel="stylesheet" href="~/css/admin/kaiadmin.min.css" />
    <link rel="stylesheet" href="~/css/admin/adminCustom.css" />
    
    @RenderSection("Styles", false)
    <title>Admin</title>
</head>
    <body>
        <div class="wrapper">
            @await Html.PartialAsync("PartialViews/Admin/_SidebarSection")
            
            <div class="main-panel">
                @await Html.PartialAsync("PartialViews/Admin/_HeaderSection")

                <div class="container">
                    @RenderBody()
                </div>
                @await Html.PartialAsync("PartialViews/Admin/_FooterSection")
            </div>
        </div>

        <!--   Core JS Files   -->
        <script src="~/js/admin/core/jquery-3.7.1.min.js"></script>
        <script src="~/js/admin/core/popper.min.js"></script>
        <script src="~/js/admin/core/bootstrap.min.js"></script>

        <!-- jQuery Scrollbar -->
        <script src="~/js/admin/plugin/jquery-scrollbar/jquery.scrollbar.min.js"></script>

        <!-- Bootstrap Notify -->
        <script src="~/js/admin/plugin/bootstrap-notify/bootstrap-notify.min.js"></script>
        @await Html.PartialAsync("PartialViews/Admin/_NoticeSection")

        <!-- Sweet Alert -->
        <script src="~/js/admin/plugin/sweetalert/sweetalert.min.js"></script>
        
        <!-- Kaiadmin JS -->
        <script src="~/js/admin/kaiadmin.min.js"></script>
        @RenderSection("Scripts", false)
    </body>
</html>