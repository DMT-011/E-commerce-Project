@model IEnumerable<E_commerce_Project.Models.ViewModels.CategoryViewModel.CategoryProductViewModel>;
@{
    ViewData["Title"] = "Home Page";
}

<!-- Slider  -->
@await Component.InvokeAsync("SliderList")

<!-- Main content (sidebar product left && list product right)  -->
<div class="main-content">
    <div class="container">
        <div class="row">
            <!-- Sidebar left -->
            <div class="col-3">
                @await Component.InvokeAsync("ProductSales")
            </div>

            <!--List products new -->
            <div class="col-9 new-product-container" style="overflow: hidden;">
                @await Component.InvokeAsync("ProductNewList")
            </div>

        </div>

    </div>
</div>

<div class="main-content main-content-full-col">
    <!-- Macbook Product List -->

    @foreach (var category in Model)
    {
        @if (category.Products.Count > 0)
        {
            <div class="container" style="overflow: hidden;">
                <div class="product-list-area">
                    <div class="left-title-area">
                        <h3 class="left-title">@category.CategoryName</h3>

                        <div class="product-carousel-nav">
                            <div class="product-prev-btn">
                                <i class="bi bi-arrow-left-square-fill product-next-icon"></i>
                            </div>

                            <div class="product-next-btn">
                                <i class="bi bi-arrow-right-square-fill product-next-icon"></i>
                            </div>
                        </div>

                    </div>

                    <div class="row no-wrap product-carousel">
                        <!-- Product Item -->
                        @foreach (var product in @category.Products)
                        {
                            <div class="col-2-4">
                                @await Html.PartialAsync("PartialViews/Customer/_ProductItem", @product)
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>


@section Scripts
{
    <script src="~/js/main/handleNextPrevItem.js" asp-append-version="true"></script>
}


