@using E_commerce_Project.Models.Enums
@model X.PagedList.IPagedList<E_commerce_Project.Models.ViewModels.AdminViewModel.AdminCustomerListViewModel>;
@{
  Layout = "_LayoutAdminTable";
  ViewBag.titleView = "Khách hàng";
  ViewBag.featureCurrent = "Danh sách khách hàng";

  // Action for pagination section
  ViewBag.action = "Customer";
}

@section StylesViewChild
{
  <link rel="stylesheet" href="/css/admin/adminAccount.css" asp-append-version="true">
  <style>
    .empty-img {
      width: 35%;
    }
  </style>
}

@section ControlsAdmin
{
  <a href="/Customer/Trash" class="btn btn-danger">
    <i class="icon-control fas fa-trash"></i>
    Thùng rác
    <span>(@ViewBag.countCustomerDel)</span>
  </a>
}

@if (Model.Count > 0)
{
  <table class="table align-middle table-product-list">
    <thead>
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Tên khách hàng</th>
      <th scope="col">Só điện thoại</th>
      <th scope="col">Email</th>
      <th scope="col">Trạng thái tài khoản</th>
      <th scope="col">Thao tác</th>
    </tr>
    </thead>

    <tbody class="table-group-divider">
    @foreach (var item in Model)
    {
      <tr>
        <th scope="row">
          <span>@item.Id</span>
        </th>
        <td>
          @item.FullName
        </td>
        <td>
          @item.Phone
        </td>
        <td>
          @item.Email
        </td>
        <td class="button-status">
          <div class="button-slider-wrap">
            <input type="checkbox" class="btn-toggle-status" data-id-user="@item.Id" id="switch-@item.Id" @(item.Status == AccountStatusType.Active ? "checked" : "")/>
            <label 
              for="switch-@item.Id"
              class="label-toggle"
              data-bs-toggle="tooltip" 
              data-bs-placement="top" 
              >
            </label>
          </div>
        </td>
        <td class="product-controls">
          <button
            class="btn btn-danger"
            data-bs-toggle="modal"
            data-bs-target="#modal-confirm-delete"
            data-user-id="@item.Id"
            data-user-name="@item.FullName"
          >
            <i class="fas fa-trash-alt"></i>
          </button>
        </td>

      </tr>
    }
    </tbody>
  </table>

  @section Pagination
  {
    @await Html.PartialAsync("PartialViews/Admin/_PaginationSection")
    }
  }

@if (Model.Count == 0)
{ 
  // Context for empty section
  ViewBag.contentEmpty = "Danh sách khách hàng rỗng";
  ViewBag.contentLink = "";
  ViewBag.actionEmpty = "";
  ViewBag.imgEmpty = "user-empty.jpg";
  @await Html.PartialAsync("PartialViews/Admin/_EmptySection")
}


<form action="" method="POST" id="form-delete-account"></form>

@section ModalConfirm
{
  <!-- Modal -->
  <div class="modal fade" id="modal-confirm-delete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Chuyển người dùng này vào thùng rác ?</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          Khách hàng <span style="font-weight: bold" class="slider-name"></span> sẽ được sẽ được chuyển vào thùng rác <span style="color: #2bb930">( có thể khôi phục lại )</span>.
        </div>  
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
          <button type="button" class="btn btn-warning btn-confirm-delete">Xác nhận</button>
        </div>
      </div>
    </div>
  </div>
}

@section ScriptsViewChild
{

  <script src="~/js/admin/notice.js"></script>
  <script src="~/js/admin/handleAjaxStatusAccount.js"></script>
  <script src="~/js/admin/deleteUser.js"></script>
}
