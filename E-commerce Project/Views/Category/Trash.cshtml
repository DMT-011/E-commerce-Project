@model X.PagedList.IPagedList<E_commerce_Project.Models.ViewModels.AdminViewModel.AdminCategoryTrashViewModel>;
@{
  Layout = "_LayoutAdminTable";
  ViewBag.titleView = "Danh mục sản phẩm";
  ViewBag.featureCurrent = "Thùng rác";

  // Action for pagination section
  ViewBag.action = "Trash";
}

<style>
  .empty-img {
    width: 40% !important;
  }
</style>

@section ControlsAdmin
{
  <a href="/Admin/Category" class="btn btn-black">
    <i class="icon-control fas fa-reply"></i>
    Quay lại
  </a>
}

@if (Model.Count > 0)
{
  <table class="table align-middle table-product-list">
    <thead>
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Tên danh mục</th>
      <th scope="col">Ngày tạo</th>
      <th scope="col">Thao tác</th>
    </tr>
    </thead>

    <tbody class="table-group-divider">
    @foreach (var item in Model)
    {
      <tr class="slide-item">
        <th scope="row">
          <span class="id-slide" style="margin-left: 2px">@item.Id</span>
        </th>
        <td>
         @item.Name
        </td>
        <td>
          @item.DateCreated
        </td>
        <td >
          <button
            class="btn btn-black btn-restore-category"
            data-bs-toggle="tooltip"
            data-bs-placement="top"
            data-bs-title="Khôi phục"
            data-category-id="@item.Id"
          >
            <i class="fas fa-sync-alt"></i>
          </button>

          <button
            class="btn btn-danger"
            data-bs-toggle="modal"
            data-bs-target="#modal-confirm-forceDelete"
            data-category-id="@item.Id"
            data-category-name="@item.Name"
          >
            <i class="fas fa-trash-alt"></i>
          </button>
        </td>
      </tr>
    }
    </tbody>
  </table>
  
  @section Pagination
  {
    @await Html.PartialAsync("PartialViews/Admin/_PaginationSection", Model)
  }
}

@if (Model.Count == 0)
{
  // Context for empty section
  ViewBag.contentEmpty = "Thùng rác rỗng, quay lại danh sách ";
  ViewBag.contentLink = "danh mục";
  ViewBag.actionEmpty = "/Admin/Category";
  ViewBag.imgEmpty = "trash-empty-color.jpg";
  
  @await Html.PartialAsync("PartialViews/Admin/_EmptySection")
}



<!-- Form restore and force delete slider -->
<form action="" method="POST" id="form-restore-category"></form>
<form action="" method="POST" id="form-force-delete-category"></form>

@section ModalConfirm
{
  <!-- Modal -->
  <div class="modal fade" id="modal-confirm-forceDelete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5">Xóa vĩnh viễn danh mục này ?</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          Hãy chắc chắn rằng bạn muốn xóa nó.
          Hành động này sẽ xóa vĩnh viễn danh mục
          <span style="font-weight: bold" class="category-name"></span>
          , không thể khôi phục lại !
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
          <button type="button" class="btn btn-danger btn-confirm-forceDel">Xóa vĩnh viễn</button>
        </div>
      </div>
    </div>
  </div>
}

@section ScriptsViewChild
{

  <script>
    const formRestore = document.querySelector("#form-restore-category");
    const btnRestore = document.querySelectorAll(".btn-restore-category");

    btnRestore.forEach(item => {
      item.addEventListener("click", function () {
        const id = this.dataset.categoryId;
        formRestore.action = `/Category/Restore/${id}`;
        formRestore.submit();
      })
    });

    const formForceDelete = document.querySelector("#form-force-delete-category");
    const btnConfirmForceDel = document.querySelector(".btn-confirm-forceDel");
    const modalConfirmForceDel = document.querySelector("#modal-confirm-forceDelete");

    if (modalConfirmForceDel) {
      modalConfirmForceDel.addEventListener('show.bs.modal', event => {
        const contentBody = document.querySelector(".category-name");
        const categoryId = event.relatedTarget.dataset.categoryId;
        const categoryName = event.relatedTarget.dataset.categoryName;

        formForceDelete.action = `/Category/ForceDelete/${categoryId}`;
        contentBody.textContent = categoryName;
      });
    }
    btnConfirmForceDel.onclick = function () {
      formForceDelete.submit();
    }
  </script>
}