@model E_commerce_Project.Models.ViewModels.SliderViewModel.SliderUpdateViewModel;

@{
    ViewBag.Title = "title";
    Layout = "_LayoutAdminForm";
    ViewBag.titleView = "Giao diện";
    ViewBag.featureCurrent = "Cập nhật slider";
}

@section StylesViewChild
{
    <link rel="stylesheet" href="~/css/admin/updateSliderForm.css" asp-append-version="true">
}

@section ControlsAdmin
{
    <button class="btn btn-primary btn-update-slider">
        <i class="icon-control fas fa-window-restore"></i>
        Cập nhập
    </button>
    <a href="/Admin/Slider" class="btn btn-black">
        <i class="icon-control fas fa-reply"></i>
        Quay lại
    </a>
}

<!-- Update slider form -->
<form action="/Slider/Update/@Model.Id" method="POST" enctype="multipart/form-data" id="form-update-slider" class="update-slider-form-area">
    <div class="row">
        <div class="col-12">
            <div class="label-notice">* Các mục đánh dấu (*) là bắt buộc</div>
        </div>
        <!-- Form side left -->
        <div class="col-9">
            <div class="form-left">
                <div class="form-group">
                    <label for="name-slider" class="form-label">Tên slider</label>
                    <input asp-for="Name" type="text" class="form-input" id="name-slider">
                </div>
                
                @if (ViewBag.countSlider != 0)
                {
                    <div class="form-group">
                        <label for="name-slider" class="form-label">Thứ tự hiển thị</label>
                        <select asp-for="Priority" asp-items="@Model.Priorities" type="text" class="form-input" id="name-slider">
                            <option value="">[Chọn thứ tự hiển thị]</option>
                        </select>
                    </div>
                }
            </div>
        </div>

        <!-- Form side right -->
        <div class="col-3">
            <div class="form-right">
                <div class="form-group">
                    <label for="img-slider" class="form-label">Hình ảnh</label>
                    <div class="upload-img-item">
                        <input asp-for="ImageSlide" type="file" id="img-slider" class="img-slider">
                        <div class="img-slider-wrapper">
                            <img accept="image/*" src="~/@Model.ImagePath" class="slider-img-view" alt="">
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label for="slider-status" class="form-label">Trạng thái</label>

                    <select asp-for="IsDisplayed" id="slider-status" class="select-input">
                        <option value="true">Hiển thị</option>
                        <option value="false">Không hiển thị</option>
                    </select>
                </div>
            </div>
        </div>
		
    </div>
</form>

@section ScriptsViewChild
{
    <script>
        const btnUpdateSlider = document.querySelector(".btn-update-slider");

        btnUpdateSlider.onclick = function () {
            document.querySelector("#form-update-slider").submit();
        }
    </script>
    
    <script>
        function handleRenderImageOnchange(inputElement, imgElement) {
            inputElement.addEventListener("input", function(e) {
                const fileImg = e.target.files[0];

                if (fileImg) {
                    const reader = new FileReader();

                    reader.onload = function(e) {
                        // assign url img to img element
                        imgElement.src = e.target.result;
                        imgElement.style.display = "inline-block";
                        imgElement.parentElement.style.borderBottom = "1px dashed #ededed";
                    }

                    // Read file as a URL
                    reader.readAsDataURL(fileImg);

                } else {
                    imgElement.src = "";
                    imgElement.style.display = "none";
                    imgElement.parentElement.style.borderBottom = "";
                }

            });
        }
        const inputImageMain = document.querySelector(".img-slider");
        const imageMain = inputImageMain.parentElement.querySelector(".slider-img-view");
        handleRenderImageOnchange(inputImageMain, imageMain);
    </script>
}
